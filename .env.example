# ---------------------------------------------------------------------------
# CFBrain configuration — copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Required: embeddings -----------------------------------------------------
# Needed for semantic search (`cfbrain query`). Keyword search (`cfbrain search`)
# works without it.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at an OpenAI-compatible gateway instead of OpenAI directly.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the embedding model / dimensions.
# Defaults: text-embedding-3-large @ 1536 dimensions.
# CFBRAIN_EMBEDDING_MODEL=text-embedding-3-large
# CFBRAIN_EMBEDDING_DIMENSIONS=1536


# --- Optional: storage engine -------------------------------------------------
# By default CFBrain runs fully local on PGLite (embedded Postgres) at
# ~/.cfbrain/brain.pglite — no server, no connection string needed.
#
# Only set this if you want to use a real Postgres / Supabase instance:
# CFBRAIN_DATABASE_URL=postgresql://user:pass@host:6543/postgres


# --- Optional: LLM-assisted features -----------------------------------------
# Used by semantic chunking and file analysis. Not required for core CRUD.
# ANTHROPIC_API_KEY=sk-ant-your-key-here


# --- Optional: Feishu / Lark wiki sync ---------------------------------------
# Requires `lark-cli` installed and authenticated separately.
# Leave all of these unset if you do not use Feishu.
#
# Your Feishu tenant domain, e.g. acme.feishu.cn
# FEISHU_DOMAIN=your-org.feishu.cn
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# LARK_APP_SECRET=your-app-secret
#
# Override the lark-cli binary if it is not on PATH:
# LARK_CLI_BIN=/opt/homebrew/bin/lark-cli
# lark-cli needs the real home dir for keychain access; set only if you
# relocate HOME (see agent-templates/shared/scripts/cfbrain-exec.sh).
# LARK_CLI_HOME=/Users/you


# --- Optional: email digest (AgentMail) --------------------------------------
# Leave unset unless you actually want CFBrain to send mail.
# No recipients are shipped by default, so an unconfigured install cannot
# accidentally mail anyone.
# AGENTMAIL_API_KEY=your-agentmail-key
# AGENTMAIL_INBOX=agent@example.com
# CFBRAIN_BRIEFING_RECIPIENTS=you@example.com,teammate@example.com


# --- Optional: paths ----------------------------------------------------------
# Where integration recipes live (defaults to <repo>/recipes).
# CFBRAIN_RECIPES_DIR=./recipes
