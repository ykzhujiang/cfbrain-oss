<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>$HOME</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.<AGENT_NAME>.cron-poll</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>set -a; source $CFBRAIN_HOME/main/.env 2&gt;/dev/null; set +a; exec /bin/bash $CFBRAIN_HOME/shared/scripts/cron-run.sh --agent-if cron-poll $CFBRAIN_HOME/shared/scripts/cron-poll-precheck.sh '执行飞书评论处理：/tmp/cfbrain-poll-result.json 中有待处理评论数据，读取后按评论处理工作流逐条处理'</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>$CFBRAIN_HOME/main/logs/cron-poll-launchd-err.log</string>
	<key>StandardOutPath</key>
	<string>$CFBRAIN_HOME/main/logs/cron-poll-launchd.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>$CFBRAIN_HOME/main</string>
</dict>
</plist>
